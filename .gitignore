# ======================================
# DocVault — Root .gitignore
# ======================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
client/dist/
client/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Terraform — state files contain secrets
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
.agents/
